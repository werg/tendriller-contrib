{
  "name": "@tendriller/cookbooks",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Adaptable decision guides and verification specimens for Tendriller pages",
  "repository": "https://github.com/werg/tendriller-contrib",
  "engines": {
    "node": ">=22.15.0"
  },
  "files": [
    "cookbooks",
    "guides",
    "catalog.json",
    "index.html",
    "agent.md",
    "llms.txt",
    "README.md",
    "PROVENANCE.md"
  ],
  "scripts": {
    "build": "node distribution/build.mjs",
    "check:generated": "node distribution/build.mjs --check",
    "check:content": "node distribution/check.mjs",
    "test": "node --test test/*.test.mjs cookbooks/*/checks/*.test.mjs",
    "check": "npm run check:generated && npm run check:content && npm test",
    "test:peer-generation": "node cookbooks/run-a-peer-application/checks/run-peer-generation.mjs",
    "test:peer-browser": "node cookbooks/run-a-peer-application/checks/run-peer-generation-browser.mjs",
    "test:peer-host": "node cookbooks/run-a-peer-application/checks/run-peer-generation-host.mjs",
    "check:peer-composition": "node cookbooks/run-a-peer-application/checks/peer-composition.mjs"
  }
}
