{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private tasks, response notices and shared summary requests",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "type",
        "response_id",
        "prompt_id",
        "revision"
      ],
      "properties": {
        "type": {
          "const": "response_submitted"
        },
        "response_id": {
          "type": "string"
        },
        "prompt_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "prompt_id"
      ],
      "properties": {
        "type": {
          "const": "facilitation_summary_request"
        },
        "prompt_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "assignment_id",
        "revision"
      ],
      "properties": {
        "type": {
          "const": "assignment_changed"
        },
        "assignment_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  ],
  "x-shared-state": {
    "facilitation": "{title?,stage:collect|discuss|closed,prompt:{id,text,description?},summary}"
  },
  "x-private-storage": "Participant-specific tasks, feedback and answers live in authenticated APIs and private session archives. No private content enters shared state, transcript or event payloads.",
  "x-agent-instructions": "AGENT.md",
  "x-command-context": {
    "module": "sessions",
    "scope": "sessions:facilitation",
    "location": "envelope; outside data",
    "capture": "tendril.scopes.capture(scope)",
    "contract": 3
  }
}
